FROM qwen3.8:27b-mlx

# ── 说明 ───────────────────────────────────────────────
# 本文件把 qwen3.8-local 指针指向官方 MLX 版（qwen3.8:27b-mlx，18GB，nvfp4 量化）。
# MLX 原生权重自带：多模态模板 + vision projector + 内嵌 MTP 投机解码头（默认启用，实测接受率 ~0.90）。
# 因此无需 draft_num_predict（那是 GGUF/llama.cpp 路径的参数，MLX 引擎自行管理 MTP）。
# 回退方法：ollama create qwen3.8-local -f Modelfile.local （切回 Q5_K_M GGUF）

# ── 上下文 ─────────────────────────────────────────────
# MLX 版原生支持 256K 上下文；沿用 131072 作为默认上限（已验证稳定，避免单图+长历史溢出）
PARAMETER num_ctx 131072

# ── 采样参数（与原 Q5 版一致，确保 WorkBuddy 调用行为不变）──
PARAMETER temperature 0.7
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0
