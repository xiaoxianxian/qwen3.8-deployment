# Qwen3.8-27B Modelfile 模板（Ollama ≥ 0.33）
# 使用说明：
#   1. 把下面两处 <你的用户名> 替换成实际路径（如 /Users/zhangsan）
#      推荐用绝对路径，Ollama 对相对路径支持不稳定
#   2. 重建模型：ollama create qwen3.8-local -f ~/models/Modelfile
#
# ⚠️ 关键语法（Ollama 0.33 起变更，2026-09 验证）：
#   - 挂载视觉投影 mmproj 必须用「第二个 FROM 行」
#   - 旧的 `PROJECTOR /path/mmproj.gguf` 写法在 0.33 已失效，会报：
#     Error: command must be one of "from", "license", "template", ...
#   - 判断依据：ollama show <模型名> 出现 Projector(clip) 且 Capabilities 含 vision

FROM /Users/<你的用户名>/models/qwen3.8-27b-Q5.gguf
FROM /Users/<你的用户名>/models/mmproj-F16.gguf

# ── 上下文窗口 ────────────────────────────────────────────
# 【重要修正】实测一张 1024×1024 图片仅消耗 ~1084 tokens，
#             不是文档里写的 "13 万 token"（旧文档误读了报错信息）。
# 真正触发 400 报错的原因是：图片 + 长对话历史总和超过 num_ctx。
#
# num_ctx 选择（M5 Pro / 48GB 实测）：
#   262144 → 模型 38GB，速度 ~3 tok/s（太慢）
#   131072 → 模型 28GB，速度 ~9.7 tok/s，100% GPU ✅ 推荐
#    65536 → 模型 24GB，速度 ~9.6 tok/s，但发图时容易 400（历史累积）
#
PARAMETER num_ctx 131072

# ── 采样参数（官方推荐值）──────────────────────────────────
PARAMETER temperature 0.7
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0

# ── 服务侧配套（不在本文件，需设环境变量，见 setup-guide.md 第八节）──
#   OLLAMA_KEEP_ALIVE=30m      模型驻留内存 30 分钟，避免每次重载
#   OLLAMA_FLASH_ATTENTION=1   大幅降低长上下文内存占用
#   OLLAMA_KV_CACHE_TYPE=q8_0  KV 缓存量化，131K 上下文必备
#
# ── ⚠️ 推理模型回复为空的新坑（2026-09 实测）──────────────
# Qwen3.8 默认开启 thinking 模式，会先用掉一部分 num_predict 用于思考，
# 如果调用时 num_predict 太小（如 60），思考就把预算吃光了，content 字段为空。
# 解决：
#   - 调用方传 options.num_predict ≥ 2000（保证有足够余量）
#   - 或传 options.think=false 关闭思考模式
#   - 或在 Ollama 层面设参数：PARAMETER think false（默认行为因版本而异）
