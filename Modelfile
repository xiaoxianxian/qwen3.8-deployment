# Qwen3.8-27B Modelfile 模板（Ollama ≥ 0.33）
# 使用说明：
#   1. 把下面两处 <你的用户名> 替换成实际路径（如 /Users/zhangsan）
#      推荐用绝对路径，Ollama 对相对路径支持不稳定
#   2. 重建模型：ollama create qwen3.8-local -f ~/models/Modelfile
#
# ⚠️ 关键语法（Ollama 0.33 起变更，2026-09 验证）：
#   - 挂载视觉投影 mmproj 必须用「第二个 FROM 行」
#   - 旧的 `PROJECTOR /path/mmproj.gguf` 写法在 0.33 已失效，会报：
#     Error: command must be one of "from", "license", "template", ...
#   - 判断依据：ollama show <模型名> 出现 Projector(clip) 且 Capabilities 含 vision

FROM /Users/<你的用户名>/models/qwen3.8-27b-Q5.gguf
FROM /Users/<你的用户名>/models/mmproj-F16.gguf

# ── 上下文窗口 ────────────────────────────────────────────
# num_ctx=131072 是实测最佳平衡点：
#   - 262144：模型膨胀到 38GB，速度降至 ~3 tok/s（太慢）
#   - 65536：  图片+长历史易触发 400（exceeds context）
#   - 131072：内存 28GB，100% GPU，~9.7 tok/s，足够装下图片+长历史
# 注意：一张 1024×1024 图片实测仅 ~1084 tokens，不是文档里写的 "13 万"。
# 400 报错的真正原因是「图片 + 长对话历史」总和超过 num_ctx，不是单张图吃掉所有预算。
# 调用方需保证 options.num_predict ≥ 2000（或传 think=false），否则 Qwen3.8 默认开启
# 思考模式会把 token 预算全部耗尽在 thinking 字段，content 返回空字符串。
PARAMETER num_ctx 131072

# ── 采样参数（官方推荐值）──────────────────────────────────
PARAMETER temperature 0.7
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0

# ── 服务侧配套（不在本文件，需设环境变量，见 setup-guide.md 第八节）──
#   OLLAMA_KEEP_ALIVE=30m       模型驻留内存 30 分钟，避免每次重载
#   OLLAMA_FLASH_ATTENTION=1    降低长上下文内存占用
#   OLLAMA_KV_CACHE_TYPE=q8_0   KV 缓存量化，131072+ 上下文推荐
